/* Lowest-numbered icon becomes the .exe / taskbar / Explorer icon on Windows. */
1 ICON "PootisBuilder.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Pootis Builder"
      VALUE "FileDescription", "Pootis Builder \xE2\x80\x94 a modern TF2 map editor"
      VALUE "FileVersion", "0.2.0"
      VALUE "ProductName", "Pootis Builder"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
