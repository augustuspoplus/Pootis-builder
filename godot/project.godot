; Pootis Builder 2.0 — Godot 4.7 Forward+ Engine Project

config_version=5

[application]

config/name="Pootis Builder 2.0 — TF2 Map Creator"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/dpi/allow_hidpi=true
window/stretch/mode="disabled"
window/stretch/aspect="ignore"

[gui]

common/snap_controls_to_pixels=true
fonts/dynamic_fonts/use_oversampling=true

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
