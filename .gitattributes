# Normalise line endings: LF in the repo, native in the working tree.
* text=auto

*.cpp   text
*.h     text
*.md    text
*.txt   text
*.sh    text eol=lf
*.ps1   text eol=crlf
CMakeLists.txt text

# Treat these as binary (no eol munging, no diff noise).
*.ttf   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.vpk   binary
*.bsp   binary
*.mdl   binary
*.vtf   binary
